# Paths here mirror the repo layout, not $HOME. See the manifest for the
# source -> target mapping.
#
# These are backstops, not the primary defence. Every source below is a `tree`
# row in the manifest, which means its target is created as a real directory
# holding one symlink per tracked file — so a tool's state lands in $HOME beside
# the links, not inside this repo. That is structural. These patterns guard the
# remaining cases: state copied in by hand, or a row switched to `link` mode
# without thinking through what the tool writes.

# Bash — machine-specific config (use local.sh.example as template)
shell/local.sh
# ...and any hand-made backup of it. Deliberately not `shell/local.sh*`, which
# would also swallow the tracked local.sh.example.
shell/local.sh.bak*

# Git — machine-specific identity, credentials, and overrides
pkgs/git/gitconfig.local

# Claude Code — track user-authored config; ignore secrets + tool-managed state.
pkgs/claude/.credentials.json
pkgs/claude/settings.local.json
pkgs/claude/history.jsonl
pkgs/claude/projects/
pkgs/claude/sessions/
pkgs/claude/session-env/
pkgs/claude/plugins/
pkgs/claude/shell-snapshots/
pkgs/claude/file-history/
pkgs/claude/paste-cache/
pkgs/claude/telemetry/
pkgs/claude/tasks/
pkgs/claude/jobs/
pkgs/claude/todos/
pkgs/claude/backups/
pkgs/claude/cache/
pkgs/claude/daemon/
pkgs/claude/daemon*.log
pkgs/claude/stats-cache.json
pkgs/claude/ide/
pkgs/claude/debug/
pkgs/claude/downloads/
pkgs/claude/chrome/
pkgs/claude/statsig/

# herdr — track config.toml; ignore the sockets, logs, and session state it
# keeps in the same directory.
pkgs/herdr/*.sock
pkgs/herdr/*.log
pkgs/herdr/session-history.json
pkgs/herdr/.plugins.lock
pkgs/herdr/config.toml.bak*

# nix — track nix.conf; ignore the flake registry it writes beside it.
pkgs/nix/registry.json

# Python build cruft
**/__pycache__/
**/.ruff_cache/

# Editor/tool backups and merge leftovers. Nothing tracked here has ever used
# these suffixes; they exist only as pre-edit copies, and a copy of an ignored
# file must not become visible just because a suffix was appended to its name.
*.bak
*.bak-*
*.orig
*.rej

# nix build output symlink
result
result-*
