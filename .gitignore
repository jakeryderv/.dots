# Pi — track user-authored agent config; ignore secrets + tool-managed state.
# Safety nets: with ~/.pi/agent pre-existing, stow only links the config files,
# so state never enters the repo. These guard against an accidental fold (fresh
# machine) or state copied in by hand.
pi/.pi/agent/auth.json
pi/.pi/agent/trust.json
pi/.pi/agent/npm/
pi/.pi/agent/sessions/
pi/.pi/agent/bin/
pi/.pi/agent/intercom/
pi/.pi/agent/mcp-cache.json
pi/.pi/agent/mcp-npx-cache.json
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/settings.json.bak
# Parent-level secrets/state (only relevant if ~/.pi gets folded on a fresh machine)
pi/.pi/web-search.json
pi/.pi/exa-usage.json
pi/.pi/playwright-profile/
pi/.pi/rules/

# Bash — machine-specific config (use local.sh.example as template)
_bash/local.sh

# Git — machine-specific identity, credentials, and overrides
git/.gitconfig.local

# Claude Code — track user-authored config; ignore secrets + tool-managed state.
# Safety nets: with ~/.claude pre-existing, stow only links the tracked files,
# so state never enters the repo. These guard against an accidental fold (fresh
# machine) or state copied in by hand.
claude/.claude/.credentials.json
claude/.claude/settings.local.json
claude/.claude/history.jsonl
claude/.claude/projects/
claude/.claude/sessions/
claude/.claude/session-env/
claude/.claude/plugins/
claude/.claude/shell-snapshots/
claude/.claude/file-history/
claude/.claude/paste-cache/
claude/.claude/telemetry/
claude/.claude/tasks/
claude/.claude/jobs/
claude/.claude/todos/
claude/.claude/backups/
claude/.claude/cache/
claude/.claude/daemon/
claude/.claude/daemon*.log
claude/.claude/stats-cache.json
claude/.claude/ide/
claude/.claude/debug/
claude/.claude/downloads/
claude/.claude/chrome/
claude/.claude/statsig/

# opencode — track user-authored config; ignore plugin machinery
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package*.json
opencode/.config/opencode/bun.lock

# Installer-managed skills (skills.sh, railway CLI) must never enter the repo.
# If an agent skills dir gets stow-folded into a symlink, installers write
# through it into the repo — these guard against committing that. Keep agent
# skill dirs real (restow with --no-folding).
pi/.pi/agent/skills/*
!pi/.pi/agent/skills/.gitkeep
opencode/.config/opencode/skills/use-railway/

# Python build cruft (e.g. qutebrowser config.py)
**/__pycache__/
**/.ruff_cache/
