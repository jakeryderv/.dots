# Pi — track user-authored agent config; ignore secrets + tool-managed state.
# Safety nets: with ~/.pi/agent pre-existing, stow only links the config files,
# so state never enters the repo. These guard against an accidental fold (fresh
# machine) or state copied in by hand.
pi/.pi/agent/auth.json
pi/.pi/agent/trust.json
pi/.pi/agent/npm/
pi/.pi/agent/sessions/
pi/.pi/agent/bin/
pi/.pi/agent/intercom/
pi/.pi/agent/mcp-cache.json
pi/.pi/agent/mcp-npx-cache.json
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/settings.json.bak
# Parent-level secrets/state (only relevant if ~/.pi gets folded on a fresh machine)
pi/.pi/web-search.json
pi/.pi/exa-usage.json
pi/.pi/playwright-profile/
pi/.pi/rules/

# Bash — machine-specific config (use local.sh.example as template)
_bash/local.sh

# Git — machine-specific identity, credentials, and overrides
git/.gitconfig.local

# opencode — track user-authored config; ignore plugin machinery
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package*.json
opencode/.config/opencode/bun.lock

# Python build cruft (e.g. qutebrowser config.py)
**/__pycache__/
**/.ruff_cache/
