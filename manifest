# Deployment manifest -- the single source of truth for what gets linked where.
#
# Columns:  PKG  MODE  SOURCE (repo-relative)  TARGET
# Whitespace-delimited; blank lines and #-comments ignored. No path may contain
# a space.
#
# PKG is declared, not derived from the path. It is what `just status <pkg>`
# filters on, and it lets several rows belong to one package (scripts ships both
# binaries and completions).
#
# MODE:
#   link  One symlink at TARGET, pointing at SOURCE (a file or a whole
#         directory). New files inside SOURCE appear at TARGET automatically.
#         Use when the directory is exclusively ours.
#   tree  Real directories at TARGET, one symlink per tracked file. Use when the
#         tool writes state or build artifacts into the same directory it reads
#         config from, or when TARGET is shared with other installers.
#
# Files are enumerated with `git ls-files`, so .gitignore is the only ignore
# list in the repo -- an untracked file is never deployed. This is why a SOURCE
# directory must contain only deployable content; docs live in docs/<pkg>.md.
#
# TARGET honors $XDG_CONFIG_HOME (default ~/.config) and $XDG_DATA_HOME
# (default ~/.local/share).
#
# Every SOURCE points into config/, home/, data/, or bin/.

# --- XDG config: directories that are exclusively ours -----------------------
alacritty       link    config/alacritty                                    $XDG_CONFIG_HOME/alacritty
nvim            link    config/nvim                                         $XDG_CONFIG_HOME/nvim
ghostty         link    config/ghostty                                      $XDG_CONFIG_HOME/ghostty
bat             link    config/bat                                          $XDG_CONFIG_HOME/bat
kitty           link    config/kitty                                        $XDG_CONFIG_HOME/kitty
wezterm         link    config/wezterm                                      $XDG_CONFIG_HOME/wezterm
direnv          link    config/direnv                                       $XDG_CONFIG_HOME/direnv
tealdeer        link    config/tealdeer                                     $XDG_CONFIG_HOME/tealdeer
kanata          link    config/kanata                                       $XDG_CONFIG_HOME/kanata
starship        link    config/starship.toml                                $XDG_CONFIG_HOME/starship.toml

# --- XDG config: the tool writes into its own config dir ---------------------
# qutebrowser writes autoconfig.yml; herdr keeps its sockets, logs, and
# session.json beside config.toml.
qutebrowser     tree    config/qutebrowser                                  $XDG_CONFIG_HOME/qutebrowser
herdr           tree    config/herdr                                        $XDG_CONFIG_HOME/herdr

# --- Shared targets: directories other installers also write into ------------
# ~/.local/bin holds 76 entries; only four are ours. ~/.config/systemd/user is
# systemd's own tree, so kanata links its unit file, not the directory.
kanata          tree    config/systemd/user                                 $XDG_CONFIG_HOME/systemd/user
fonts           tree    data/fonts                                          $XDG_DATA_HOME/fonts
scripts         tree    data/bash-completion/completions                    $XDG_DATA_HOME/bash-completion/completions
scripts         tree    bin                                                 $HOME/.local/bin

# --- $HOME: tools that ignore XDG entirely -----------------------------------
git             link    home/gitconfig                                      $HOME/.gitconfig
tmux            link    home/tmux.conf                                      $HOME/.tmux.conf
editorconfig    link    home/editorconfig                                   $HOME/.editorconfig
vim             tree    home/vim                                            $HOME/.vim

claude          tree    home/claude                                         $HOME/.claude

# Skills shared by every coding agent. ~/.agents/skills is also written by
# skill installers, so each skill is linked individually rather than the dir.
# Claude Code reads ~/.claude/skills; the second row mirrors the installer's
# own per-skill symlinks there.
agent-skills    link    home/agents/skills/project-practices                $HOME/.agents/skills/project-practices
agent-skills    link    home/agents/skills/project-practices                $HOME/.claude/skills/project-practices
