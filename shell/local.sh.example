#!/usr/bin/env bash
# =====================================================================
# local.sh — machine-specific bash config (NOT committed to git)
# =====================================================================
#
# This file is the per-machine layer on top of the portable modules in
# ~/.dots/bash. The real `local.sh` is git-ignored; this `.example` is
# the committed template. Put anything here that:
#   - has hardcoded / machine-specific paths (CUDA version, toolkits)
#   - may not exist on every machine (guard with `command -v` or `[ -f ]`)
#   - is secret and must not be committed (API keys, tokens)
#   - overrides a committed module for this box only
#
# Loaded LAST by _init_.sh, so it can override earlier modules.
#
# Set up on a new machine:
#   cp ~/.dots/bash/local.sh.example ~/.dots/bash/local.sh
#   then uncomment / edit the bits that apply.
# =====================================================================

# --- Secrets / env (examples) ----------------------------------------
# export OPENAI_API_KEY="..."
# export ANTHROPIC_API_KEY="..."

# --- PATH additions --------------------------------------------------
# Use the guarded form to avoid duplicating entries when sourced repeatedly:
# case ":$PATH:" in
#     *":$HOME/.local/some-tool/bin:"*) ;;
#     *) export PATH="$HOME/.local/some-tool/bin:$PATH" ;;
# esac
#
# Do NOT re-add ~/.local/bin or ~/.npm-global/bin: exports.sh already adds
# both, guarded. Installers like to append an unguarded
# `export PATH="$HOME/.local/bin:$PATH"` here and to ~/.profile; delete those
# rather than keeping them. ~/.profile's own stock block adds ~/.local/bin a
# second time because Ubuntu sources ~/.bashrc before it, which is harmless
# and left alone.

# NOT here: fzf, starship and direnv. flake.nix guarantees all three, so their
# shell integrations are tracked in tools.sh. Adding them here too would run
# each hook twice.
#
# Also NOT here: `source ~/.cargo/env`, the bun installer's BUN_INSTALL block,
# or a Go root. rustup, go and bun come from flake.nix. What their installers
# append prepends ~/.cargo/bin or ~/.bun/bin *ahead* of the profile, which
# shadows the flake's copies -- `just doctor` reports exactly that. The only
# PATH entries they still need are for `cargo install` and `go install`
# output, appended after the profile:
# case ":$PATH:" in
#     *":$HOME/.cargo/bin:"*) ;;
#     *) export PATH="$PATH:$HOME/.cargo/bin" ;;
# esac

# --- CUDA toolkit (match the version installed on this machine) -------
# export PATH="/usr/local/cuda-XX.X/bin:$PATH"
# export LD_LIBRARY_PATH="/usr/local/cuda-XX.X/lib64:$LD_LIBRARY_PATH"

# --- ROS -------------------------------------------------------------
# source /opt/ros/jazzy/setup.bash

# --- envman ----------------------------------------------------------
# [ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
