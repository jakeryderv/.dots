#!/usr/bin/env bash
# =====================================================================
# local.sh — machine-specific bash config (NOT committed to git)
# =====================================================================
#
# This file is the per-machine layer on top of the shared config in
# ~/.config/shell (config/shell in the repo). The real `local.sh` is
# git-ignored; this `.example` is the committed template. Both bash and zsh
# source it, last, so keep it to what both understand. Put anything here that:
#   - has hardcoded / machine-specific paths (CUDA version, toolkits)
#   - may not exist on every machine (guard with `command -v` or `[ -f ]`)
#   - is secret and must not be committed (API keys, tokens)
#   - overrides a committed module for this box only
#
# Loaded LAST by the rc file, so it can override anything before it.
#
# Set up on a new machine:
#   cp ~/.dots/config/shell/local.sh.example ~/.dots/config/shell/local.sh
#   then uncomment / edit the bits that apply.
# =====================================================================

# --- Secrets / env (examples) ----------------------------------------
# export OPENAI_API_KEY="..."
# export ANTHROPIC_API_KEY="..."

# --- PATH additions --------------------------------------------------
# Use the guarded form to avoid duplicating entries when sourced repeatedly:
# case ":$PATH:" in
#     *":$HOME/.local/some-tool/bin:"*) ;;
#     *) export PATH="$HOME/.local/some-tool/bin:$PATH" ;;
# esac
#
# Do NOT re-add ~/.local/bin: env.sh already adds it, guarded, and loads nvm
# for Node and npm globals. Do not restore ~/.npm-global/bin or an npm prefix.
# Installers like to append an unguarded
# `export PATH="$HOME/.local/bin:$PATH"` here and to ~/.profile; delete those
# rather than keeping them. ~/.profile's own stock block adds ~/.local/bin a
# second time because Ubuntu sources ~/.bashrc before it, which is harmless
# and left alone.

# NOT here: fzf, starship and direnv. Their guarded shell integrations are
# already in the rc file. Adding them here too would run each hook twice.
#
# Also NOT here: `source ~/.cargo/env`, the bun installer's PATH block, or a
# Go root. See docs/software.md for upstream installation methods. env.sh adds
# ~/.cargo/bin, ~/.bun/bin and ~/go/bin alongside ~/.local/bin. Skip redundant
# installer-generated PATH blocks; no GOROOT override is needed.

# --- CUDA toolkit (match the version installed on this machine) -------
# export PATH="/usr/local/cuda-XX.X/bin:$PATH"
# export LD_LIBRARY_PATH="/usr/local/cuda-XX.X/lib64:$LD_LIBRARY_PATH"

# --- ROS -------------------------------------------------------------
# source /opt/ros/jazzy/setup.bash

# --- envman ----------------------------------------------------------
# [ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
