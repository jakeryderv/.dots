#!/usr/bin/env bash
# dots - this repository's deployer and health checks, from anywhere.
#
# The implementation is dots.py at the repo root. This wrapper only finds the repo, so
# `dots status`, `dots apply`, `dots doctor` work from any directory. It is
# deployed to ~/.local/bin by the `scripts` package. Override the repo location
# with DOTS_REPO.

set -euo pipefail

REPO="${DOTS_REPO:-$HOME/.dots}"

if ! command -v python3 >/dev/null 2>&1; then
    printf 'error: python3 is not installed (nix profile add ~/.dots)\n' >&2
    exit 1
fi

if [[ ! -f "$REPO/dots.py" ]]; then
    printf 'error: no dots.py under %s (set DOTS_REPO to override)\n' "$REPO" >&2
    exit 1
fi

exec python3 "$REPO/dots.py" --repo "$REPO" "$@"
