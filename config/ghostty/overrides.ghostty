# Tracked theme overrides for Ghostty (committed, not machine-local).
#
# Loaded via `config-file = overrides.ghostty` AFTER carbonfox.ghostty, so values
# here win over the vendored theme. (Ghostty processes config-file includes at
# the end of the parent file, in order, and an included file overrides the
# parent — so theme overrides must live here, after the theme include.)
#
# Keeps carbonfox.ghostty byte-for-byte faithful to the nightfox upstream.

# Cursor uses the cell's foreground color (overrides the theme's static
# cursor-color = #f2f4f8). Pairs with cursor-text = cell-background in
# config.ghostty for a clean color-inverting block cursor.
cursor-color = cell-foreground

# --- Startup directory ---
# New windows always open in $HOME, ignoring the previously focused surface's
# CWD (default working-directory = inherit, window-inherit = true would follow
# whatever dir you were in). Tabs and splits still inherit the current dir
# because their *-inherit-working-directory options stay at their default (true).
working-directory = home
window-inherit-working-directory = false

# --- Shell ---
# No `command` on purpose: ghostty inherits the login shell (docs/zsh.md), so
# it and herdr start the same shell without either naming it. Set `command =
# zsh` here to try a shell before `chsh`; it starts zsh in this terminal alone.
