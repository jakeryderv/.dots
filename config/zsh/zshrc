# ~/.zshrc -- what only zsh understands. Deployed by dots from
# config/zsh/zshrc. Everything both shells share -- environment, aliases,
# functions, the machine-specific local.sh -- is in ~/.config/shell
# (config/shell in the repo); this file is history, completion, keybindings,
# the --zsh flavour of each tool's shell hook, and the plugins from flake.nix.
# It mirrors config/bash/bashrc section for section, so the two shells behave
# the same where they can; the plugins section is the one bash has no
# counterpart for.

shell_config="$HOME/.config/shell"
if [[ ! -r $shell_config/env.sh ]]; then
    print -u2 "warning: $shell_config missing; shell config NOT loaded (run: dots apply shell)"
fi
[[ -r $shell_config/env.sh ]] && source "$shell_config/env.sh"

# --- history -----------------------------------------------------------------
# The same policy as bash: skip duplicates and space-prefixed lines, append
# rather than overwrite, flush each command as it runs so parallel tmux panes
# do not overwrite each other. Not SHARE_HISTORY, on purpose: that would
# interleave every pane's recall, which the bash side deliberately avoids.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=200000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE APPEND_HISTORY INC_APPEND_HISTORY
setopt INTERACTIVE_COMMENTS

# --- completion and keymap ---------------------------------------------------
# The flake's tools ship zsh completions under the profile's site-functions
# (gh, rg, fd, bat, uv, cargo, ...); putting that on fpath is the whole wiring.
# zsh-completions (flake.nix) installs there too, so it needs no line of
# its own.
fpath=("$HOME/.nix-profile/share/zsh/site-functions" $fpath)
autoload -Uz compinit && compinit
# Case-insensitive, coloured, as the readline settings in bashrc. `menu no`
# is what fzf-tab asks for: it draws the menu itself, and reads the
# descriptions format for its group headers. Without fzf-tab, Tab and
# Shift-Tab below cycle matches the plain way, which is what bashrc does.
zstyle ':completion:*' menu no
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '[%d]'
bindkey -e # emacs keymap, the same base as bash's readline
bindkey '^I' menu-complete
bindkey '^[[Z' reverse-menu-complete
# Up/Down are bound in the plugins section: history-substring-search owns
# them when it is present, and the builtin prefix search when it is not.

# --- shared ------------------------------------------------------------------
[[ -r $shell_config/functions.sh ]] && source "$shell_config/functions.sh"
[[ -r $shell_config/aliases.sh ]] && source "$shell_config/aliases.sh"

# zsh-only aliases: the (D) glob qualifier includes dotfiles, which is what
# bashrc's shopt dotglob does for its lsd/lsl.
alias lsd='ls -CxdF -- *(D) 2>/dev/null'
alias lsl='ls -ldF -- *(D) 2>/dev/null'

# --- keybindings -------------------------------------------------------------
# Ctrl-F: tmux-sessionizer (config/scripts), as a widget so the prompt redraws
# after it returns. fzf takes Ctrl-R, Ctrl-T, Alt-C below; no collision.
if command -v tmux-sessionizer >/dev/null 2>&1; then
    tmux-sessionizer-widget() {
        tmux-sessionizer
        zle reset-prompt
    }
    zle -N tmux-sessionizer-widget
    bindkey '^F' tmux-sessionizer-widget
fi

# --- tool hooks --------------------------------------------------------------
# All three come from flake.nix; the guards keep a machine without the flake
# usable, just plainer. Hooks that install their own bindings go after ours.
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# --- plugins -----------------------------------------------------------------
# All from flake.nix, with the same guards as the hooks: absent, the shell is
# plainer, not broken. The order is the one the READMEs require. fzf-tab
# after compinit and before the two that wrap widgets; syntax-highlighting
# before history-substring-search. zsh-completions is on fpath above.
plugins="$HOME/.nix-profile/share"
# Tab completes through fzf: it takes over ^I from menu-complete above.
[[ -r $plugins/fzf-tab/fzf-tab.zsh ]] && source "$plugins/fzf-tab/fzf-tab.zsh"
# The rest of the last matching history line, greyed, after the cursor;
# Right or End accepts it.
[[ -r $plugins/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
    source "$plugins/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r $plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
    source "$plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
# Up/Down search history by what is already typed, as bashrc binds them.
# The plugin matches the text anywhere in the line; the builtin fallback
# matches it as a prefix, which is exactly bash's behaviour.
if [[ -r $plugins/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]]; then
    source "$plugins/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh"
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
else
    autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
    zle -N up-line-or-beginning-search
    zle -N down-line-or-beginning-search
    bindkey '^[[A' up-line-or-beginning-search
    bindkey '^[[B' down-line-or-beginning-search
fi
unset plugins

# --- machine-specific, untracked ---------------------------------------------
[[ -r $shell_config/local.sh ]] && source "$shell_config/local.sh"
unset shell_config
