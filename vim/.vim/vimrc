" Personal Vim configuration. Neovim has a separate Lua-based config.

set nocompatible
scriptencoding utf-8

let mapleader = " "
let maplocalleader = " "

filetype plugin indent on
syntax enable

runtime! ftplugin/man.vim

" Editing and navigation
set number
set relativenumber
set mouse=a
set hidden
set breakindent
set cursorline
set scrolloff=10
set splitright
set splitbelow
set confirm

" Search and completion
set ignorecase
set smartcase
set incsearch
set hlsearch
set wildmenu
set wildmode=longest:full,full

" Indentation and visible whitespace
set tabstop=4
set shiftwidth=4
" -1 makes softtabstop follow shiftwidth, so <Tab>/<BS> move by a whole indent
" step instead of a single space.
set softtabstop=-1
set expandtab
set list
set listchars=tab:»\ ,trail:·,nbsp:␣

" Two-space filetypes, mirroring the web-indent autocmd in the Neovim config and
" the matching rules in ~/.editorconfig. Vim has no EditorConfig support, so this
" hardcodes the convention instead of reading a project's file: a repository with
" different rules is NOT honoured here (Neovim, which reads EditorConfig, is).
"
" softtabstop is repeated even though it is -1 globally: 'filetype plugin indent
" on' above registers the bundled ftplugins first, so they run before this and
" some pin their own value -- runtime/ftplugin/markdown.vim sets softtabstop=4.
" Without restoring -1 here, <Tab> would insert 4 spaces while >> shifted 2.
let s:two_space_filetypes = 'lua,html,css,scss,sass,less,'
      \ . 'javascript,javascriptreact,typescript,typescriptreact,'
      \ . 'json,jsonc,yaml,markdown'
augroup web_indent
  autocmd!
  execute 'autocmd FileType ' . s:two_space_filetypes
        \ . ' setlocal tabstop=2 shiftwidth=2 softtabstop=-1'
augroup END

" Responsiveness and terminal colors
set updatetime=250
set timeoutlen=300
set termguicolors
set background=dark

" Chrome tweaks over Vim's built-in default highlighting, using the carbonfox
" values the Neovim config keeps in lua/colors.lua (the terminal supplies the
" same palette, see ghostty/.config/ghostty/carbonfox.ghostty):
"   - CursorLine defaults to Grey40 (#666666), a bright band against the
"     #161616 background. #353535 is what carbonfox renders in Neovim; note it
"     is not one of the entries in lua/colors.lua, so it is spelled out here.
"   - listchars default to Cyan/bold Blue; bg4 (#535353) keeps them dim but
"     legible against both the normal and cursorline backgrounds. Same value
"     Neovim uses for Whitespace/NonText/SpecialKey.
" Vim draws listchars with SpecialKey and NonText -- it has no 'Whitespace'
" group, that one is a Neovim addition (:highlight Whitespace gives E411).
" cterm values are fallbacks for terminals without true colour.
function! s:ChromeOverrides() abort
  highlight CursorLine guibg=#353535 ctermbg=236 cterm=NONE
  highlight SpecialKey guifg=#535353 ctermfg=240
  highlight NonText    guifg=#535353 ctermfg=240 gui=NONE cterm=NONE
endfunction

" Re-apply on :colorscheme, which resets highlight groups, then apply once now.
augroup chrome_overrides
  autocmd!
  autocmd ColorScheme * call s:ChromeOverrides()
augroup END
call s:ChromeOverrides()

" Keep persistent undo data local and out of the dotfiles repository.
let s:undo_dir = expand('~/.vim/undo')
if !isdirectory(s:undo_dir)
  call mkdir(s:undo_dir, 'p', 0700)
endif
execute 'set undodir=' . fnameescape(s:undo_dir . '//')
set undofile

" Seamless Ctrl-h/j/k/l navigation across Vim splits and tmux panes.
function! s:Navigate(direction, tmux_direction) abort
  let l:previous_window = winnr()
  execute 'wincmd ' . a:direction
  if winnr() == l:previous_window && !empty($TMUX)
    call system('tmux select-pane ' . a:tmux_direction)
  endif
endfunction

nnoremap <silent> <C-h> :call <SID>Navigate('h', '-L')<CR>
nnoremap <silent> <C-j> :call <SID>Navigate('j', '-D')<CR>
nnoremap <silent> <C-k> :call <SID>Navigate('k', '-U')<CR>
nnoremap <silent> <C-l> :call <SID>Navigate('l', '-R')<CR>
nnoremap <silent> <C-\> :call <SID>Navigate('p', '-l')<CR>

