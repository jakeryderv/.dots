[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[fetch]
	prune = true
[push]
	autoSetupRemote = true
	default = simple
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[diff]
	algorithm = histogram
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
	mnemonicPrefix = true
	interHunkContext = 2
[pull]
	rebase = true
[rebase]
	autoStash = true
[color]
	ui = auto
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[alias]
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	branches = branch -a
    cleanup = "!git branch --merged main --format='%(refname:short)' | grep -vE '^(main|master)$' | xargs -r git branch -d"
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	hyperlinks = true
	side-by-side = true
	line-numbers = true
	# carbonfox, installed as a .tmTheme by the `bat` package -- delta reads
	# bat's theme registry. Requires `bat cache --build`; see docs/bat.md.
	syntax-theme = carbonfox
[include]
	path = ~/.gitconfig.local
