# Font family (Bold + Italic auto-detected from the same family)
font-family = "0xProto Nerd Font Mono"

# Font size in points (default is ~12; bump up slightly)
font-size = 12

# Disable programming ligatures — delete this line to keep them
font-feature = -calt

# Extra line spacing (10% taller cells)
adjust-cell-height = 10%

# font-thicken is macOS-only and has no effect on Linux — left off
# font-thicken = true

# Theme — carbonfox (palette vendored from nightfox; see carbonfox.ghostty)
config-file = carbonfox.ghostty

# Local overrides — loaded AFTER the theme so values here win over it.
# (Ghostty processes config-file includes at the end of the parent file, in the
#  order listed, and an included file overrides the parent. So to override a
#  theme value it must live in an include that comes after the theme include.)
config-file = local.ghostty

# --- Background image ---
# Dark-space wallpaper (tracked in ~/.dots/_wallpapers, not stowed)
background-image = ~/.dots/_wallpapers/dark-space-blur-s5.jpg

# Fill the window, preserving aspect ratio (may clip edges)
background-image-fit = cover

# Anchor point for the image (this is the default; here for clarity)
background-image-position = center

# Don't tile the image (irrelevant when fit = cover, but documents intent)
background-image-repeat = false

# Image visibility, relative to background-opacity. Raise toward 1.0 for a
# more prominent wallpaper; lower it if text over the bright nebula is hard to read.
background-image-opacity = 0.20

# Related window-transparency options (left at defaults; uncomment to change):
#   background-opacity keeps the window solid (1) so the image sits on the carbonfox bg
#   background-blur blurs the desktop behind the window, and only applies when opacity < 1
# background-opacity = 1
# background-blur = 20

# --- Window ---
# Remove title bar and borders (matches kitty's hide_window_decorations and
# alacritty's decorations = "None"). Valid: none | auto | client | server.
window-decoration = none

# Padding between the terminal cells and the window edges (default is only 2)
window-padding-x = 5
window-padding-y = 5

# Distribute leftover pixels (from cell-size vs window-size mismatch) evenly
# across all four edges instead of piling them on one side
window-padding-balance = true

# Don't show the dimensions popup when resizing the window
resize-overlay = never

# --- Cursor ---
# Block cursor, no blinking
cursor-style = block
cursor-style-blink = false

# Glyph under the cursor uses the cell's background color — the other half of
# the invert. The cursor's own color (cursor-color = cell-foreground) lives in
# local.ghostty so it can override the theme's cursor-color; see note up top.
cursor-text = cell-background

# Fully opaque cursor
cursor-opacity = 1

# Click in the prompt to move the cursor there (needs shell integration / OSC 133)
cursor-click-to-move = true

# Make the block cursor apply at the PROMPT too. By default Ghostty's shell
# integration forces a bar at the prompt; "no-cursor" disables just that. The
# rest of this list is the documented v1.3.1 default set, kept explicit so the
# other features (title, path) stay on regardless of merge semantics.
shell-integration-features = no-cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path

# --- Behavior ---
# Hide the mouse pointer as soon as you start typing
mouse-hide-while-typing = true

# Desktop notifications: drop the "copied to clipboard" toast, keep config-reload
# (default is clipboard-copy,config-reload)
app-notifications = no-clipboard-copy

# confirm-close-surface is left at its default (true). Shell integration already
# suppresses the prompt when you're sitting at a shell prompt, so it only asks
# when a command is actually running.
