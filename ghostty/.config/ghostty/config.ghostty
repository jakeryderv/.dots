# Font family (Bold + Italic auto-detected from the same family)
font-family = "0xProto Nerd Font Mono"

# Font size in points (default is ~12; bump up slightly)
font-size = 12

# Disable programming ligatures — delete this line to keep them
font-feature = -calt

# Extra line spacing (10% taller cells)
adjust-cell-height = 10%

# font-thicken is macOS-only and has no effect on Linux — left off
# font-thicken = true

# Theme — carbonfox (palette vendored from nightfox; see carbonfox.ghostty)
config-file = carbonfox.ghostty

# Local overrides — loaded AFTER the theme so values here win over it.
# (Ghostty processes config-file includes at the end of the parent file, in the
#  order listed, and an included file overrides the parent. So to override a
#  theme value it must live in an include that comes after the theme include.)
config-file = local.ghostty

# --- Background image ---
# Dark-space wallpaper (tracked in ~/.dots/_wallpapers, not stowed)
background-image = ~/.dots/_wallpapers/dark-space-blur-s5.jpg

# Fill the window, preserving aspect ratio (may clip edges)
background-image-fit = cover

# Anchor point for the image (this is the default; here for clarity)
background-image-position = center

# Don't tile the image (irrelevant when fit = cover, but documents intent)
background-image-repeat = false

# Image visibility, relative to background-opacity. Raise toward 1.0 for a
# more prominent wallpaper; lower it if text over the bright nebula is hard to read.
background-image-opacity = 0.05

# Force a minimum text/background contrast ratio (WCAG scale: 1 = off … 21 = max)
# so text stays legible over the brighter parts of the wallpaper. 1.1 just
# prevents invisible text while preserving carbonfox's colors; raise toward 3 for
# stronger readability (pushes text toward black/white). Ignores emoji & images.
minimum-contrast = 1.1

# Related window-transparency options (left at defaults; uncomment to change):
#   background-opacity keeps the window solid (1) so the image sits on the carbonfox bg
#   background-blur blurs the desktop behind the window, and only applies when opacity < 1
# background-opacity = 1
# background-blur = 20

# --- Window ---
# Remove title bar and borders (matches kitty's hide_window_decorations and
# alacritty's decorations = "None"). Valid: none | auto | client | server.
window-decoration = none

# Padding between the terminal cells and the window edges (default is only 2)
window-padding-x = 0
window-padding-y = 0

# Distribute leftover pixels (from cell-size vs window-size mismatch) evenly
# across all four edges instead of piling them on one side
window-padding-balance = true

# Extend the wallpaper/edge color into the padding area so it reaches the window
# edge (default "background" shows a flat #161616 border around the image)
window-padding-color = extend

# Don't show the dimensions popup when resizing the window
resize-overlay = never

# --- Cursor ---
# Block cursor, no blinking
cursor-style = block
cursor-style-blink = false

# Glyph under the cursor uses the cell's background color — the other half of
# the invert. The cursor's own color (cursor-color = cell-foreground) lives in
# local.ghostty so it can override the theme's cursor-color; see note up top.
cursor-text = cell-background

# Fully opaque cursor
cursor-opacity = 1

# Click in the prompt to move the cursor there (needs shell integration / OSC 133)
cursor-click-to-move = true

# Make the block cursor apply at the PROMPT too: by default Ghostty's shell
# integration forces a bar at the prompt; "no-cursor" disables just that.
# Also enable ssh-env + ssh-terminfo (both off by default): installs Ghostty's
# terminfo on remote hosts (one-time per host, cached) and forwards
# COLORTERM/TERM_PROGRAM so colors/keys render correctly over SSH. The remaining
# features (no-sudo, title, path) match the v1.3.1 defaults.
shell-integration-features = no-cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# --- Behavior ---
# Hide the mouse pointer as soon as you start typing
mouse-hide-while-typing = true

# Scroll speed — these ARE the defaults, set explicitly so it's easy to tweak
# per-machine. discrete = notched mouse wheels (lines/notch); precision = hi-res
# touchpad. Raise/lower if scrolling feels off on another machine. Range 0.01–10000.
mouse-scroll-multiplier = precision:1,discrete:3

# Desktop notifications: drop the "copied to clipboard" toast, keep config-reload
# (default is clipboard-copy,config-reload)
app-notifications = no-clipboard-copy

# Bell behavior — full list written explicitly for clarity.
#   on:  attention (nudge the desktop / GNOME notification when the bell rings
#        while Ghostty is unfocused), border (flash a border around the terminal
#        until refocused — the in-window cue that matters since we have no titlebar)
#   off: title (the 🔔-in-title is mostly invisible with window-decoration = none),
#        system (OS alert sound), audio (custom sound, macOS-only anyway)
bell-features = no-system,no-audio,attention,no-title,border

# confirm-close-surface is left at its default (true). Shell integration already
# suppresses the prompt when you're sitting at a shell prompt, so it only asks
# when a command is actually running.

# Application instancing. detect (the default) = one shared process for normal
# launches, but a separate instance when launched with CLI args (so custom-config
# launches still work). Set explicitly for clarity. (true = always shared,
# false = always separate.)
gtk-single-instance = detect

# --- Keybinds: tabs & splits (ctrl+alt scheme, consistent with wezterm) ---
# These ADD to Ghostty's ctrl+shift defaults (left as-is). All ctrl+alt-based,
# so no clash with tmux (prefix Alt+a; vim-tmux-navigator's root Ctrl+hjkl).

# Tabs: cycle and move
keybind = ctrl+alt+n=next_tab
keybind = ctrl+alt+p=previous_tab
keybind = ctrl+alt+shift+n=move_tab:1
keybind = ctrl+alt+shift+p=move_tab:-1

# Splits: create (\ = side-by-side, - = stacked)
keybind = ctrl+alt+\=new_split:right
keybind = ctrl+alt+-=new_split:down

# Splits: close & zoom the active pane
keybind = ctrl+alt+x=close_surface
keybind = ctrl+alt+z=toggle_split_zoom

# Splits: navigate (vim h/j/k/l; the default ctrl+alt+arrows still work too)
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right

# Splits: resize by 5 cells (arrow keys, per your request)
keybind = ctrl+alt+shift+arrow_left=resize_split:left,5
keybind = ctrl+alt+shift+arrow_down=resize_split:down,5
keybind = ctrl+alt+shift+arrow_up=resize_split:up,5
keybind = ctrl+alt+shift+arrow_right=resize_split:right,5
