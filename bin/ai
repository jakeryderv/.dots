#!/usr/bin/env bash
#
# ai — llm helpers for the terminal
#
#   ai [options] <command> [args] [-- question]
#
# Commands: man help why how sum grep ask chunk ml code
#
# Each one gathers context (a man page, --help output, grep hits, a file,
# stdin), hands it to `llm`, and renders the markdown that comes back. They
# live here rather than in shell/llm.sh so nvim, tmux, cron, and other scripts
# can reach them too; shell/llm.sh keeps the short interactive names.
#
set -uo pipefail

readonly PROG=${0##*/}
readonly VERSION=1.0.0

# Appended to the man/help prompts unless overridden. The renderer is a
# markdown renderer, so the model is told to emit markdown.
readonly MARKDOWN_APPEND='Be concise and straight to the point, always format outputs nicely and in strict universal markdown syntax.'

# Scratch space for `chunk`; see cmd_chunk.
tmp_dir=''
cleanup() {
    [[ -n $tmp_dir ]] && rm -rf -- "$tmp_dir"
    return 0
}
trap cleanup EXIT

# Options: glow | bat | batcat | cat. glow looks the best; use cat when piping
# the output into something else. MANAI_RENDERER is the name shell/llm.sh used
# before this script existed and is still honored.
renderer=${AI_RENDERER:-${MANAI_RENDERER:-glow}}
model=''

# Set by split_args: everything before `--` and everything after it.
subject=()
question_parts=()

# ----------------------------------------------------------------- util -----

die() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    exit "${2:-2}"
}

# Wrong arity gets that command's own usage line, not the full help — which is
# forty lines about nine other commands.
usage_err() {
    printf 'usage: %s\n' "$1" >&2
    exit 2
}

# A named renderer that isn't installed falls back to cat rather than failing:
# the answer is already paid for by the time we get here.
render() {
    case $renderer in
    glow)
        if command -v glow >/dev/null 2>&1; then
            glow
            return
        fi
        ;;
    bat | batcat)
        # Canonical name first: bat comes from flake.nix, and apt's batcat is
        # the older fallback. Matches bin/bs.
        local bat=''
        if command -v bat >/dev/null 2>&1; then
            bat=bat
        elif command -v batcat >/dev/null 2>&1; then
            bat=batcat
        fi
        if [[ -n $bat ]]; then
            "$bat" --language markdown --paging=never
            return
        fi
        ;;
    cat | '') ;;
    *)
        printf '%s: unknown renderer %q, using cat\n' "$PROG" "$renderer" >&2
        ;;
    esac
    cat
}

# `-m` belongs to llm's default `prompt` subcommand, so it goes first and the
# subcommand name is left implicit.
run_llm() {
    if [[ -n $model ]]; then
        llm -m "$model" "$@"
    else
        llm "$@"
    fi
}

build_prompt() {
    local prepend=$1 append=$2 prompt=$3
    printf '%s%s%s' "${prepend:+$prepend }" "$prompt" "${append:+ $append}"
}

# Split on the first `--`: subject on the left, question on the right.
split_args() {
    local seen=0 arg
    subject=()
    question_parts=()
    for arg in "$@"; do
        if ((seen == 0)) && [[ $arg == -- ]]; then
            seen=1
        elif ((seen)); then
            question_parts+=("$arg")
        else
            subject+=("$arg")
        fi
    done
}

require_stdin() {
    [[ -t 0 ]] && usage_err "$1"
    return 0
}

# ------------------------------------------------------------- commands -----

cmd_man() {
    (($#)) || usage_err "$PROG man <command> [-- question]"
    split_args "$@"
    ((${#subject[@]})) || die 'no command specified'

    local cmd=${subject[0]}
    # Without a `--`, trailing words are the question: `ai man git rebase` and
    # `ai man git -- rebase` mean the same thing.
    question_parts=("${subject[@]:1}" "${question_parts[@]}")

    man -w "$cmd" >/dev/null 2>&1 || die "no man page found for '$cmd'" 1

    local prompt
    prompt=$(build_prompt \
        "${MANAI_PREPEND-You are a Unix expert providing help based on provided manpage.}" \
        "${MANAI_APPEND-$MARKDOWN_APPEND}" \
        "${question_parts[*]:-Explain and show common usage.}")

    man "$cmd" | col -bx | run_llm "$prompt" | render
}

cmd_help() {
    (($#)) || usage_err "$PROG help <command> [subcommand...] [-- question]
       $PROG help - [-- question]      # help text on stdin"
    split_args "$@"
    ((${#subject[@]})) || die 'no command specified'

    local help_text
    if [[ ${subject[0]} == - ]]; then
        # A shell function or builtin can only be introspected by the shell
        # that defines it, so shell/llm.sh's helpai captures the text and
        # pipes it in here.
        require_stdin "$PROG help - [-- question]   # expects help text on stdin"
        help_text=$(cat)
    else
        command -v "${subject[0]}" >/dev/null 2>&1 ||
            die "command not found: '${subject[0]}'" 1
        help_text=$("${subject[@]}" --help 2>&1) || help_text=$("${subject[@]}" -h 2>&1)
    fi

    [[ -n $help_text ]] || die "no help output from '${subject[*]}'" 1

    local prompt
    prompt=$(build_prompt \
        "${HELPAI_PREPEND-You are a Unix expert providing help based on command help output.}" \
        "${HELPAI_APPEND-$MARKDOWN_APPEND}" \
        "${question_parts[*]:-Explain and show common usage.}")

    printf '%s\n' "$help_text" | run_llm "$prompt" | render
}

cmd_why() {
    require_stdin "<command> 2>&1 | $PROG why"
    run_llm 'Explain what went wrong and how to fix it' | render
}

cmd_how() {
    (($#)) || usage_err "$PROG how <description>"
    run_llm "You are a Unix/Linux command-line expert. Respond with the best single command or short pipeline.
	Rules:
		- prefer POSIX or GNU coreutils
		- no long prose
		- no emojis
		- no safety disclaimers
		- no alternatives unless requested
		- assume bash
		- output must be copy-paste runnable

	prompt: how to $*" | render
}

cmd_sum() {
    require_stdin "<command> | $PROG sum"
    run_llm 'Summarize the following text concisely. Output only the summary, no preamble.' | render
}

cmd_grep() {
    (($# >= 3)) || usage_err "$PROG grep <pattern> <file> <question>
       AI_GREP_CONTEXT sets the context window (default: 20)"

    local pattern=$1 file=$2
    shift 2

    [[ -f $file ]] || die "file not found: $file" 1

    local ctx=${AI_GREP_CONTEXT:-${GREPASK_CONTEXT:-20}}
    local total_lines match_count
    total_lines=$(wc -l <"$file")
    match_count=$(grep -c -- "$pattern" "$file") || match_count=0

    {
        echo "File: $file ($total_lines lines total)"
        echo "Pattern: $pattern ($match_count matches)"
        echo ''
        echo '=== Match locations ==='
        grep -n -- "$pattern" "$file"
        echo ''
        echo "=== Expanded context ($ctx lines around each match) ==="
        grep -n -B "$ctx" -A "$ctx" -- "$pattern" "$file"
    } | run_llm "$*" | render
}

cmd_ask() {
    (($#)) || [[ ! -t 0 ]] || usage_err "$PROG ask <question> [< stdin]"
    # stdin is inherited: `ai ask "..." < file` and a bare pipe both work.
    run_llm "$*" | render
}

cmd_chunk() {
    (($# >= 2)) || usage_err "$PROG chunk <file> <question>
       AI_CHUNK_SIZE sets the chunk size in bytes (default: 40000)"

    local file=$1
    shift
    local question=$*

    [[ -f $file ]] || die "file not found: $file" 1

    local size=${AI_CHUNK_SIZE:-${CHUNKASK_SIZE:-40000}}
    tmp_dir=$(mktemp -d) || die 'could not create a temporary directory' 1

    # -C keeps chunks line-aligned (no mid-line or mid-character splits).
    split -C "$size" "$file" "$tmp_dir/chunk_" || die "could not split $file" 1

    local answers="$tmp_dir/answers.txt" chunk
    : >"$answers"
    for chunk in "$tmp_dir"/chunk_*; do
        run_llm "Given this excerpt, answer the question: $question" <"$chunk" >>"$answers"
        printf '\n---\n\n' >>"$answers"
    done

    run_llm "Combine the following partial answers into a single coherent answer to the question: $question" \
        <"$answers" | render
}

cmd_ml() {
    (($#)) || usage_err "$PROG ml <question>"
    local m=${model:-${AI_ML_MODEL:-qwen2.5-coder:14b}}
    llm -m "$m" \
        --no-stream \
        --system 'You are an expert machine learning researcher. Be precise, technical, and concise.' \
        "$@" | render
}

cmd_code() {
    (($#)) || usage_err "$PROG code <prompt>"
    # -x extracts the fenced block, so the output is paste-ready and does not
    # go through the markdown renderer.
    run_llm -s 'Respond ONLY with a single fenced code block. No explanation.' -x "$*"
}

# ----------------------------------------------------------------- main -----

usage() {
    cat <<EOF
${PROG} ${VERSION} — llm helpers for the terminal

usage: ${PROG} [options] <command> [args] [-- question]

commands  man <cmd> [-- q]              explain a man page
          help <cmd...> [-- q]          explain a command's --help output
          help - [-- q]                 same, with the help text on stdin
          why                           explain an error read from stdin
          how <description>             intent to command
          sum                           summarize stdin
          grep <pat> <file> <question>  grep, then ask about the hits
          ask <question>                general question (stdin optional)
          chunk <file> <question>       map/reduce a question over a big file
          ml <question>                 ask a local model an ML question
          code <prompt>                 print one fenced code block, nothing else

options   -m, --model MODEL   pass a model to llm
          --renderer WHEN     glow | bat | cat (default: glow)
          -h, --help          this text
          -V, --version       version

env       AI_RENDERER         default renderer (MANAI_RENDERER also honored)
          AI_GREP_CONTEXT     grep context lines (default: 20)
          AI_CHUNK_SIZE       chunk bytes (default: 40000)
          AI_ML_MODEL         model for \`ml\` (default: qwen2.5-coder:14b)
          MANAI_PREPEND / MANAI_APPEND    override the \`man\` prompt wrapper
          HELPAI_PREPEND / HELPAI_APPEND  override the \`help\` prompt wrapper

examples  ${PROG} man tar -- extract a single file
          ${PROG} help just -- what does --dry-run do
          make 2>&1 | ${PROG} why
          ${PROG} how convert webm to mp4
          ${PROG} grep TODO notes.md what is left
EOF
}

while (($#)); do
    case $1 in
    -h | --help)
        usage
        exit 0
        ;;
    -V | --version)
        printf '%s %s\n' "$PROG" "$VERSION"
        exit 0
        ;;
    -m | --model)
        [[ -n ${2-} ]] || usage_err "$PROG -m MODEL <command> ..."
        model=$2
        shift 2
        ;;
    --model=*)
        model=${1#--model=}
        shift
        ;;
    --renderer)
        [[ -n ${2-} ]] || usage_err "$PROG --renderer WHEN <command> ..."
        renderer=$2
        shift 2
        ;;
    --renderer=*)
        renderer=${1#--renderer=}
        shift
        ;;
    -*)
        die "unknown option: $1"
        ;;
    *)
        break
        ;;
    esac
done

if (($# == 0)); then
    usage
    exit 0
fi

command -v llm >/dev/null 2>&1 ||
    die 'llm is not installed (uv tool install llm, or pipx install llm)' 1

command=$1
shift

case $command in
man) cmd_man "$@" ;;
help) cmd_help "$@" ;;
why) cmd_why "$@" ;;
how) cmd_how "$@" ;;
sum) cmd_sum "$@" ;;
grep) cmd_grep "$@" ;;
ask) cmd_ask "$@" ;;
chunk) cmd_chunk "$@" ;;
ml) cmd_ml "$@" ;;
code) cmd_code "$@" ;;
*) die "unknown command: $command (try '$PROG -h')" ;;
esac
