# ShellCheck configuration for this repository.
#
# Read automatically by every consumer -- bash-language-server (which runs
# ShellCheck internally for editor diagnostics) and `shellcheck` invoked by
# `dots check` in CI -- so the editor and the CI gate can't drift.
# ShellCheck searches the checked file's directory and its parents, so this
# root-level file covers tools/ and config/.

# Follow `source`d files so functions/variables defined in a sibling module are
# known. This is what CI's `shellcheck -x` was doing via a flag.
external-sources=true

# SC1091 "not following: file was not specified as input". The shell modules are
# sourced at runtime through paths that only exist once deployed to $HOME, so
# static resolution can't find them. external-sources handles the cases that are
# resolvable; this silences the remainder.
disable=SC1091

# Deliberately NOT set here: severity=warning. CI applies `-S warning` as the
# gate; the editor is left more verbose so info-level hints stay visible while
# writing.
