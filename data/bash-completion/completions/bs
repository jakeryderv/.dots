# shellcheck shell=bash
# Completion for bs (bin/bs).
#
# Options come from `bs -h`; keep the two in sync when adding a flag.

# Section names from the bs preset config, i.e. the "[dev]" headers.
_bs_presets() {
    local config=${XDG_CONFIG_HOME:-$HOME/.config}/bs/config
    [[ -r $config ]] || return 0
    sed -n 's/^[[:space:]]*\[\([^]]\{1,\}\)\].*/\1/p' "$config"
}

_bs() {
    # _init_completion assigns all four names; declare them local so it never
    # leaks into the global namespace, even though bs only reads cur and prev.
    # shellcheck disable=SC2034 # words/cword are for _init_completion's benefit
    local cur prev words cword

    if declare -F _init_completion >/dev/null; then
        _init_completion || return
    else
        cur=${COMP_WORDS[COMP_CWORD]}
        prev=${COMP_WORDS[COMP_CWORD - 1]}
    fi

    case $prev in
    --preset)
        mapfile -t COMPREPLY < <(compgen -W "$(_bs_presets)" -- "$cur")
        return
        ;;
    --min-size | --max-size)
        mapfile -t COMPREPLY < <(compgen -W '1K 10K 100K 1M 10M 100M 1G' -- "$cur")
        return
        ;;
    --depth)
        mapfile -t COMPREPLY < <(compgen -W '1 2 3 4 5' -- "$cur")
        return
        ;;
    --watch)
        mapfile -t COMPREPLY < <(compgen -W '1 2 5 10 30' -- "$cur")
        return
        ;;
    -g | --grep | -e | --ext | --exclude)
        # free-form pattern or extension list; nothing sensible to offer
        return
        ;;
    esac

    if [[ $cur == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W '
            -a --all -d --dirs -f --files -x --exec -l --links
            -g --grep -e --ext --exclude --min-size --max-size --today --week
            -t --time -s --size -n --name -E --sort-ext -r --reverse -H --group
            -1 --oneline -c --count -L --long -T --target --icons --relative
            --tree --summary --no-color --json --total
            --fzf --multi --preview --edit
            -R --recursive --depth --git --watch --preset
            -h --help' -- "$cur")
        return
    fi

    # the sole positional is a directory
    if declare -F _filedir >/dev/null; then
        _filedir -d
    else
        mapfile -t COMPREPLY < <(compgen -d -- "$cur")
        compopt -o filenames 2>/dev/null
    fi
}
complete -F _bs bs
