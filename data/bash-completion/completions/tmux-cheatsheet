# shellcheck shell=bash
# Completion for tmux-cheatsheet (scripts/.local/bin/tmux-cheatsheet).
#
# The script takes no positional arguments, so options are the whole surface.

_tmux_cheatsheet() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    mapfile -t COMPREPLY < <(compgen -W '--pick --plain --no-color -h --help' -- "$cur")
}
complete -F _tmux_cheatsheet tmux-cheatsheet
