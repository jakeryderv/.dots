#!/usr/bin/env bash

set -euo pipefail

blue=''
yellow=''
muted=''
bold=''
reset=''

usage() {
    cat <<'EOF'
Usage: tmux-cheatsheet [--pick] [--plain|--no-color]

Generate a cheatsheet from the running tmux server's effective key bindings.

Options:
  --pick       Open the cheatsheet in the configured fzf picker.
  --plain      Print without ANSI colors (alias for --no-color).
  --no-color   Print without ANSI colors.
  -h, --help   Show this help.

NO_COLOR also disables ANSI colors.
EOF
}

die() {
    printf 'tmux-cheatsheet: %s\n' "$*" >&2
    return 1
}

configure_colors() {
    local enabled=$1

    if [[ $enabled == 1 && -z ${NO_COLOR:-} ]]; then
        blue=$'\033[38;2;120;169;255m'
        yellow=$'\033[38;2;249;168;38m'
        muted=$'\033[38;2;162;169;176m'
        bold=$'\033[1m'
        reset=$'\033[0m'
    else
        blue=''
        yellow=''
        muted=''
        bold=''
        reset=''
    fi
}

require_runtime() {
    local mode=$1

    command -v tmux >/dev/null 2>&1 || {
        die 'tmux is not installed or is not on PATH'
        return 1
    }
    tmux list-keys -T prefix >/dev/null 2>&1 || {
        die 'cannot connect to a running tmux server'
        return 1
    }

    if [[ $mode == pick ]] && ! command -v fzf >/dev/null 2>&1; then
        die 'fzf is required for --pick but is not installed or is not on PATH'
        return 1
    fi
}

binding_rows() {
    local table=$1

    if ! tmux list-keys -T "$table" >/dev/null 2>&1; then
        return
    fi

    {
        tmux list-keys -T "$table" | awk '
            {
                for (i = 1; i <= NF; i++) {
                    if ($i == "-T") {
                        key = $(i + 2)
                        gsub(/\\\\/, "\\", key)
                        sub(/^\\/, "", key)

                        command = ""
                        for (j = i + 3; j <= NF; j++) {
                            command = command (command == "" ? "" : " ") $j
                        }
                        print key "\t" command
                        break
                    }
                }
            }'
        printf '%s\n' '__TMUX_CHEATSHEET_BINDINGS__'
        tmux list-keys -a -N -P '' -T "$table"
    } | awk '
        $0 == "__TMUX_CHEATSHEET_BINDINGS__" {
            bindings = 1
            next
        }

        !bindings {
            separator = index($0, "\t")
            key = substr($0, 1, separator - 1)
            keys[++key_count] = key
            commands[key] = substr($0, separator + 1)
            next
        }

        {
            best = ""
            for (i = 1; i <= key_count; i++) {
                key = keys[i]
                if (substr($0, 1, length(key)) == key && length(key) > length(best)) {
                    best = key
                }
            }

            if (best == "") {
                next
            }

            description = substr($0, length(best) + 1)
            sub(/^[[:space:]]+/, "", description)
            print best "\t" description "\t" commands[best]
        }'
}

describe_binding() {
    local description=$1
    local action

    case "$description" in
    *tmux-fzf/main.sh*) printf '%s' 'Open tmux-fzf manager' ;;
    *extrakto/scripts/open.sh*) printf '%s' 'Open Extrakto text picker' ;;
    *tpm/bindings/install_plugins*) printf '%s' 'TPM: install plugins' ;;
    *tpm/bindings/update_plugins*) printf '%s' 'TPM: update plugins' ;;
    *tpm/bindings/clean_plugins*) printf '%s' 'TPM: remove unused plugins' ;;
    *tmux-resurrect/scripts/save.sh*) printf '%s' 'Resurrect: save tmux environment' ;;
    *tmux-resurrect/scripts/restore.sh*) printf '%s' 'Resurrect: restore tmux environment' ;;
    *)
        if [[ $description =~ send-keys[[:space:]]+-F?X[[:space:]]+([a-z-]+) ]]; then
            action=${BASH_REMATCH[1]}
            case "$action" in
            begin-selection) printf '%s' 'Begin selection' ;;
            clear-selection) printf '%s' 'Clear selection' ;;
            copy-pipe-and-cancel | copy-selection-and-cancel) printf '%s' 'Copy selection and exit copy mode' ;;
            copy-pipe-end-of-line-and-cancel) printf '%s' 'Copy to end of line and exit' ;;
            append-selection-and-cancel) printf '%s' 'Append selection to buffer and exit' ;;
            cursor-left | cursor-right | cursor-up | cursor-down) printf 'Move %s' "${action#cursor-}" ;;
            start-of-line) printf '%s' 'Move to start of line' ;;
            end-of-line) printf '%s' 'Move to end of line' ;;
            back-to-indentation) printf '%s' 'Move to first non-space character' ;;
            history-top) printf '%s' 'Go to top of history' ;;
            history-bottom) printf '%s' 'Go to bottom of history' ;;
            top-line | middle-line | bottom-line) printf '%s' "Move to ${action%-line} of screen" ;;
            page-up | page-down | halfpage-up | halfpage-down | scroll-up | scroll-down)
                action=${action//-/ }
                printf '%s' "${action^}"
                ;;
            scroll-middle) printf '%s' 'Center current line' ;;
            previous-word | previous-space | next-word | next-word-end | next-space | next-space-end)
                action=${action//-/ }
                printf '%s' "${action^}"
                ;;
            search-forward) printf '%s' 'Search forward' ;;
            search-backward) printf '%s' 'Search backward' ;;
            search-again) printf '%s' 'Repeat search' ;;
            search-reverse) printf '%s' 'Repeat search in reverse' ;;
            jump-forward) printf '%s' 'Jump forward to character' ;;
            jump-backward) printf '%s' 'Jump backward to character' ;;
            jump-to-forward) printf '%s' 'Jump forward before character' ;;
            jump-to-backward) printf '%s' 'Jump backward after character' ;;
            jump-again) printf '%s' 'Repeat last character jump' ;;
            jump-reverse) printf '%s' 'Repeat last character jump in reverse' ;;
            next-matching-bracket) printf '%s' 'Jump to matching bracket' ;;
            previous-paragraph | next-paragraph)
                action=${action//-/ }
                printf '%s' "${action^}"
                ;;
            select-line) printf '%s' 'Select current line' ;;
            rectangle-toggle) printf '%s' 'Toggle rectangular selection' ;;
            other-end) printf '%s' 'Move to other end of selection' ;;
            set-mark) printf '%s' 'Set navigation mark' ;;
            jump-to-mark) printf '%s' 'Jump to navigation mark' ;;
            toggle-position) printf '%s' 'Toggle between cursor positions' ;;
            refresh-from-pane) printf '%s' 'Refresh captured pane contents' ;;
            cancel) printf '%s' 'Exit copy mode' ;;
            goto-line) printf '%s' 'Go to line' ;;
            *)
                action=${action//-/ }
                printf '%s' "${action^}"
                ;;
            esac
        elif [[ $description == command-prompt*'(repeat)'* ]]; then
            printf '%s' 'Set repeat count'
        elif [[ $description == *'select-pane -L'* ]]; then
            printf '%s' 'Select pane to the left'
        elif [[ $description == *'select-pane -D'* ]]; then
            printf '%s' 'Select pane below'
        elif [[ $description == *'select-pane -U'* ]]; then
            printf '%s' 'Select pane above'
        elif [[ $description == *'select-pane -R'* ]]; then
            printf '%s' 'Select pane to the right'
        elif [[ $description == *'select-pane -l'* ]]; then
            printf '%s' 'Select previously active pane'
        elif ((${#description} > 96)); then
            printf '%s…' "${description:0:95}"
        else
            printf '%s' "$description"
        fi
        ;;
    esac
}

classify_binding() {
    local description=$1
    local friendly=$2
    local command=$3
    local primary searchable

    primary=${command%% *}
    searchable="${description,,} ${friendly,,} ${command,,}"

    case "$searchable" in
    *tmux-resurrect*)
        printf '%s' sessions
        return
        ;;
    *tmux-fzf* | *extrakto* | *tpm/bindings/* | */plugins/*)
        printf '%s' plugins
        return
        ;;
    esac

    case "$primary" in
    new-session | rename-session | kill-session | attach-session | choose-client | detach-client | suspend-client)
        printf '%s' sessions
        return
        ;;
    switch-client)
        if [[ $command == *' -T '* ]]; then
            printf '%s' other
        else
            printf '%s' sessions
        fi
        return
        ;;
    break-pane | capture-pane | display-panes | join-pane | kill-pane | last-pane | move-pane | pipe-pane | resize-pane | rotate-window | select-pane | swap-pane | split-window)
        printf '%s' panes
        return
        ;;
    kill-window | last-window | link-window | move-window | new-window | next-layout | next-window | previous-layout | previous-window | rename-window | respawn-window | select-layout | select-window | swap-window | unlink-window)
        printf '%s' windows
        return
        ;;
    choose-buffer | clear-history | customize-mode | delete-buffer | display-message | list-buffers | list-commands | list-keys | load-buffer | paste-buffer | save-buffer | set-buffer | show-buffer | show-messages)
        printf '%s' copy_and_commands
        return
        ;;
    esac

    case "$searchable" in
    *session* | *client* | *detach*) printf '%s' sessions ;;
    *pane* | *split* | *synchron* | *marked*) printf '%s' panes ;;
    *window* | *layout* | *alert*) printf '%s' windows ;;
    *copy* | *paste* | *buffer* | *command* | *message* | *binding* | *customize*) printf '%s' copy_and_commands ;;
    *) printf '%s' other ;;
    esac
}

print_group() {
    local title=$1
    shift
    local entry key description

    (($# > 0)) || return 0
    printf '\n  %s%s%s%s\n' "$bold" "$muted" "$title" "$reset"
    for entry in "$@"; do
        IFS=$'\t' read -r key description <<<"$entry"
        printf '    %s%-12s%s %s\n' "$yellow" "$key" "$reset" "$description"
    done
}

print_prefix_commands() {
    local key description command friendly category entry
    local -a sessions=() windows=() panes=() plugins=() copy_and_commands=() other=()

    printf '\n%s%sPREFIX COMMANDS%s\n' "$bold" "$blue" "$reset"
    while IFS=$'\t' read -r key description command; do
        [[ -n $key ]] || continue
        friendly=$(describe_binding "$description")
        category=$(classify_binding "$description" "$friendly" "$command")
        entry=$key$'\t'$friendly

        case "$category" in
        sessions) sessions+=("$entry") ;;
        windows) windows+=("$entry") ;;
        panes) panes+=("$entry") ;;
        plugins) plugins+=("$entry") ;;
        copy_and_commands) copy_and_commands+=("$entry") ;;
        *) other+=("$entry") ;;
        esac
    done < <(binding_rows prefix)

    print_group 'SESSIONS & CLIENTS' "${sessions[@]}"
    print_group 'WINDOWS & LAYOUTS' "${windows[@]}"
    print_group 'PANES' "${panes[@]}"
    print_group 'PLUGINS & TOOLS' "${plugins[@]}"
    print_group 'COPY, BUFFERS & COMMANDS' "${copy_and_commands[@]}"
    print_group 'OTHER BUILT-INS' "${other[@]}"
}

print_section() {
    local title=$1
    local table=$2
    local key description command friendly

    printf '\n%s%s%s%s\n' "$bold" "$blue" "$title" "$reset"
    while IFS=$'\t' read -r key description command; do
        [[ -n $key ]] || continue
        friendly=$(describe_binding "$description")
        printf '  %s%-12s%s %s\n' "$yellow" "$key" "$reset" "$friendly"
    done < <(binding_rows "$table")
}

print_cheatsheet() {
    local mode=$1
    local prefix interaction_help

    prefix=$(tmux show-option -gv prefix)
    if [[ $mode == pick ]]; then
        interaction_help='Type to filter · Ctrl+U clears · Esc or Ctrl+C closes.'
    else
        interaction_help='Run with --pick for interactive filtering.'
    fi

    printf '%s%sTMUX KEYBINDING CHEATSHEET%s\n' "$bold" "$blue" "$reset"
    printf '%sEffective bindings from the running server · Prefix: %s%s\n' "$muted" "$prefix" "$reset"
    printf '%s%s%s\n' "$muted" "$interaction_help" "$reset"
    printf '%sKey notation: C = Ctrl, M = Alt/Meta, S = Shift.%s\n' "$muted" "$reset"

    print_prefix_commands
    print_section 'GLOBAL KEYS (NO PREFIX)' root
    print_section 'COPY MODE (VI)' copy-mode-vi
    print_section 'RESIZE MODE' resize-mode

    printf '\n%sTip:%s %s + / describes one binding interactively.\n' "$blue" "$reset" "$prefix"
}

run_picker() {
    print_cheatsheet pick | fzf --ansi --no-sort --layout=reverse \
        --info=inline --header-lines=4 --header-lines-border=bottom --cycle \
        --prompt='filter> ' --pointer='▶' \
        --color='bg:#161616,bg+:#262626,fg:#f2f4f8,fg+:#f2f4f8,hl:#78a9ff,hl+:#78a9ff,info:#a2a9b0,prompt:#f9a826,pointer:#78a9ff,border:#535353,header:#a2a9b0' \
        --bind='enter:ignore,ctrl-u:clear-query' >/dev/null
}

main() {
    local mode=print
    local color=1

    while (($# > 0)); do
        case "$1" in
        --pick) mode=pick ;;
        --plain | --no-color) color=0 ;;
        -h | --help)
            usage
            return
            ;;
        *)
            usage >&2
            die "unknown option: $1"
            return 2
            ;;
        esac
        shift
    done

    configure_colors "$color"
    require_runtime "$mode" || return

    if [[ $mode == pick ]]; then
        run_picker
    else
        print_cheatsheet print
    fi
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
