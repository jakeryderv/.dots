#!/usr/bin/env bash
#
# gconf — inspect and edit git config by scope
#
#   gconf [scope] [action]
#
# Scopes:  l|local   g|global   s|system
# Actions: l|list (default)   e|edit   o|origin
# Report:  a|all — a table per scope, each annotated with origins
#
set -uo pipefail

readonly PROG=${0##*/}
readonly VERSION=1.4.0

# Scratch space for git's NUL-delimited output; see show().
tmp_dir=''
cleanup() {
    [[ -n $tmp_dir ]] && rm -rf -- "$tmp_dir"
    return 0
}
trap cleanup EXIT

# ---------------------------------------------------------------- colors ----
# Honors NO_COLOR (https://no-color.org), TERM=dumb, and non-tty stdout.
color_mode=auto

setup_colors() {
    local on=0
    case $color_mode in
    always) on=1 ;;
    never) on=0 ;;
    auto) [[ -t 1 && ${TERM-} != dumb && -z ${NO_COLOR-} ]] && on=1 ;;
    esac

    if ((on)); then
        C_META=$'\e[38;5;108m'    # scope / file column .. green
        C_SECTION=$'\e[38;5;244m' # section prefix ....... grey
        C_KEY=$'\e[38;5;81m'      # leaf key ............. cyan
        C_EQ=$'\e[38;5;240m'      # equals ............... dim
        C_VAL=$'\e[38;5;180m'     # value ................ sand
        C_WARN=$'\e[38;5;209m'    # errors ............... orange
        C_RESET=$'\e[0m'
    else
        C_META='' C_SECTION='' C_KEY='' C_EQ='' C_VAL='' C_WARN='' C_RESET=''
    fi
}

die() {
    printf '%s%s: %s%s\n' "$C_WARN" "$PROG" "$1" "$C_RESET" >&2
    exit "${2:-2}"
}

# Shown when invoked with no scope, so a bare `gconf` orients rather than
# dumping every scope. Mirrors the summary at the top of this file.
brief() {
    cat <<EOF
${PROG} — inspect and edit git config by scope

usage: ${PROG} [scope] [action]

scopes    l|local   g|global   s|system
actions   l|list (default)   e|edit   o|origin

${PROG} a   report: a table per scope, each with origins
${PROG} -h  full help
EOF
}

usage() {
    cat <<EOF
${PROG} ${VERSION} — inspect and edit git config by scope

usage: ${PROG} [options] [scope] [action]

scopes    l, local     this repository (.git/config)
          g, global    your user (~/.gitconfig)
          s, system    machine-wide (/etc/gitconfig)

actions   l, list      print key=value               [default]
          e, edit      open the file in git's editor
          o, origin    list, annotated with source file
          (actions apply to local, global, and system)

report    a, all       one table per scope, each with origins; takes no
                       action, since it spans every file at once

options   --color=WHEN  always | never | auto (default)
          -h, --help    this text
          -V, --version print version

examples  ${PROG}              # this summary
          ${PROG} a            # a table per scope, with origins
          ${PROG} g            # global list
          ${PROG} g e          # edit ~/.gitconfig
          ${PROG} g o          # global list + which file each value is in
          ${PROG} local edit   # long forms work too
EOF
}

# ---------------------------------------------------------------- render ----
# Reads git's NUL-delimited `--null` output on stdin and pretty-prints it:
#   [meta column]  section.  key = value
# Two passes so the meta column can be width-aligned.
render() {
    local nmeta=${1:-0} # how many fields git prefixes to each record
    local -a fields=() metas=() keys=() vals=() valued=()
    local field meta base width=0 i j n=0

    # git emits a flat NUL-delimited field stream: nmeta meta fields per record,
    # then one "key\nvalue" field. A value can hold =, tabs, and newlines but
    # never a NUL, so grouping by stride parses exactly — no guessing which
    # lines are continuations. A field with no newline at all is a valueless
    # key (a bare boolean); "key\n" is a key set to the empty string.
    while IFS= read -r -d '' field; do
        fields+=("$field")
    done

    local stride=$((nmeta + 1)) total=${#fields[@]}
    for ((i = 0; i + stride <= total; i += stride)); do
        meta=""
        for ((j = 0; j < nmeta; j++)); do
            meta+="${fields[i + j]} "
        done
        meta=${meta% }
        base=${fields[i + nmeta]}

        metas+=("$meta")
        if [[ $base == *$'\n'* ]]; then
            keys+=("${base%%$'\n'*}")
            vals+=("${base#*$'\n'}")
            valued+=(1)
        else
            keys+=("$base")
            vals+=("")
            valued+=(0)
        fi
        ((${#meta} > width)) && width=${#meta}
        ((n++))
    done

    ((n == 0)) && {
        printf '%s(no values set)%s\n' "$C_SECTION" "$C_RESET"
        return 0
    }

    local key val section leaf out cont
    for ((i = 0; i < n; i++)); do
        key=${keys[i]} val=${vals[i]}

        # git keys are section[.subsection].leaf — subsections may contain dots,
        # so split on the LAST dot to isolate the leaf.
        if [[ $key == *.* ]]; then
            section="${key%.*}."
            leaf=${key##*.}
        else
            section=""
            leaf=$key
        fi

        out=""
        ((width > 0)) && printf -v out '%s%-*s%s  ' "$C_META" "$width" "${metas[i]}" "$C_RESET"
        out+="${C_SECTION}${section}${C_RESET}${C_KEY}${leaf}${C_RESET}"
        ((valued[i])) && out+="${C_EQ} = ${C_RESET}${C_VAL}${val%%$'\n'*}${C_RESET}"
        printf '%s\n' "$out"

        # continuation lines of a multi-line value
        if [[ $val == *$'\n'* ]]; then
            while IFS= read -r cont; do
                printf '%*s%s%s%s\n' $((width > 0 ? width + 2 : 0)) "" "$C_VAL" "  $cont" "$C_RESET"
            done <<<"${val#*$'\n'}"
        fi
    done
}

# -------------------------------------------------------------- git call ----
# Output lands in a file rather than a variable because `--null` records
# contain NUL bytes, which a shell variable cannot hold. Keeping stderr
# separate also stops a warning emitted on an otherwise successful call from
# being rendered as a config line.
run_config() {
    if [[ -z $tmp_dir ]]; then
        tmp_dir=$(mktemp -d) || die "could not create a temporary directory"
    fi
    git config --null "$@" >"$tmp_dir/out" 2>"$tmp_dir/err"
}

# git's own message is the error, not an empty listing.
git_error() {
    local msg
    msg=$(<"$tmp_dir/err")
    msg=${msg#fatal: }
    msg=${msg#error: }
    printf '%s' "${msg:-git config failed}"
}

# mode `strict` exits on a git error; `soft` reports it in place and carries
# on, so the all-scopes report survives a missing /etc/gitconfig.
emit() {
    local mode=$1
    shift
    local status nmeta=0 a
    for a in "$@"; do
        [[ $a == --show-scope || $a == --show-origin ]] && ((nmeta++))
    done

    run_config "$@"
    status=$?

    if ((status != 0)); then
        [[ $mode == strict ]] && die "$(git_error)" "$status"
        printf '%s%s%s\n' "$C_WARN" "$(git_error)" "$C_RESET"
        return 0
    fi

    [[ -s $tmp_dir/err ]] && cat "$tmp_dir/err" >&2

    if [[ ! -s $tmp_dir/out ]]; then
        printf '%s(no values set)%s\n' "$C_SECTION" "$C_RESET"
        return 0
    fi
    render "$nmeta" <"$tmp_dir/out"
}

show() { emit strict "$@"; }

# `all` is a report rather than a scope you can act on: one table per scope,
# each annotated with the file every value came from. Within a scope the origin
# still varies, since include.path and includeIf pull in other files.
show_all() {
    local s first=1
    for s in --local --global --system; do
        ((first)) || printf '\n'
        first=0
        printf '%s%s%s\n' "$C_META" "${s#--}" "$C_RESET"

        if [[ $s == --local ]] && ! git rev-parse --git-dir >/dev/null 2>&1; then
            printf '%s(not inside a git repository)%s\n' "$C_SECTION" "$C_RESET"
            continue
        fi
        emit soft "$s" --list --show-origin
    done
}

# ------------------------------------------------------------------ main ----
main() {
    local -a positional=()
    local arg

    for arg in "$@"; do
        case $arg in
        --color=*) color_mode=${arg#--color=} ;;
        --color) color_mode=always ;;
        -h | --help | help | h)
            setup_colors
            usage
            exit 0
            ;;
        -V | --version)
            printf '%s %s\n' "$PROG" "$VERSION"
            exit 0
            ;;
        -*)
            setup_colors
            die "unknown option '$arg' (try --help)"
            ;;
        *) positional+=("$arg") ;;
        esac
    done

    case $color_mode in
    always | never | auto) ;;
    *)
        color_mode=auto
        setup_colors
        die "--color must be always, never, or auto"
        ;;
    esac
    setup_colors

    # No scope given: orient instead of dumping every scope. `gconf a` is the
    # explicit way to ask for the merged view.
    if ((${#positional[@]} == 0)); then
        brief
        exit 0
    fi

    command -v git >/dev/null || die "git not found on PATH" 127

    ((${#positional[@]} <= 2)) ||
        die "too many arguments: ${positional[*]} (want: [scope] [action])"

    local scope action
    case "${positional[0]}" in
    a | all) scope=all ;;
    l | local) scope=--local ;;
    g | global) scope=--global ;;
    s | system) scope=--system ;;
    *) die "unknown scope '${positional[0]}' (want: local, global, system, all)" ;;
    esac

    # `all` is a report over every scope, not one of them, so the actions that
    # target a single file do not apply to it.
    if [[ $scope == all ]]; then
        ((${#positional[@]} == 1)) ||
            die "'all' takes no action — it always lists every scope with origins"
        show_all
        return
    fi

    case "${positional[1]-list}" in
    l | ls | list) action=list ;;
    e | ed | edit) action=edit ;;
    o | origin | where) action=origin ;;
    *) die "unknown action '${positional[1]}' (want: list, edit, origin)" ;;
    esac

    # friendlier than git's raw "fatal: --local can only be used inside a git repository"
    if [[ $scope == --local ]] && ! git rev-parse --git-dir >/dev/null 2>&1; then
        die "not inside a git repository — try '$PROG global' or '$PROG all'"
    fi

    case $action in
    list) show "$scope" --list ;;
    origin) show "$scope" --list --show-origin ;;
    edit) git config "$scope" --edit ;;
    esac
}

main "$@"
