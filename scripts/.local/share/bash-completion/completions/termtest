# shellcheck shell=bash
# Completion for termtest (scripts/.local/bin/termtest).
#
# Subcommands come from termtest's dispatch table; keep the two in sync when
# adding one. Aliases (info, links, sgr, ul, gfx, ...) are deliberately left
# out — they still work, they just do not clutter the candidate list.

_termtest() {
    # _init_completion assigns all four names; declare them local so it never
    # leaks into the global namespace, even though termtest only reads two.
    # shellcheck disable=SC2034 # words/cword are for _init_completion's benefit
    local cur prev words cword

    if declare -F _init_completion >/dev/null; then
        _init_completion || return
    else
        cur=${COMP_WORDS[COMP_CWORD]}
        prev=${COMP_WORDS[COMP_CWORD - 1]}
    fi

    local subs='all env link delta styles underlines colors unicode
        clip title cwd notify graphics cursor keys help version'

    # `help <sub>` completes to another subcommand; `delta [file]` to a path
    case $prev in
    help)
        mapfile -t COMPREPLY < <(compgen -W "$subs" -- "$cur")
        return
        ;;
    delta)
        if declare -F _filedir >/dev/null; then
            _filedir
        else
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            compopt -o filenames 2>/dev/null
        fi
        return
        ;;
    esac

    # only the first word is a subcommand; the rest are free-form arguments
    # (link takes a url and text, clip/title/notify take message strings)
    if ((COMP_CWORD == 1)); then
        mapfile -t COMPREPLY < <(compgen -W "$subs" -- "$cur")
    else
        COMPREPLY=()
    fi
}
complete -F _termtest termtest
