{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-terra",
  "permission": {
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",
      "git blame *": "allow",
      "git describe *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git branch --show-current": "allow",
      "git stash list *": "allow",
      "git worktree list *": "allow",
      "git remote -v": "allow",
      "git push *": "deny"
    },
    "edit": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking@2026.7.4"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.78"],
      "enabled": true
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 30000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 10
  },
  "provider": {
    "openrouter": {
      "models": {
        "~anthropic/claude-sonnet-latest": {},
        "~openai/gpt-latest": {},
        "~google/gemini-pro-latest": {},
        "~google/gemini-flash-latest": {},
        "anthropic/claude-opus-4.8": {},
        "openai/gpt-5.5": {},
        "google/gemini-3.1-pro-preview": {}
      }
    },
    "ollama": {
      "models": {
        "qwen3:8b": {
          "name": "qwen3:8b"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
