{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "small_model": "openai/gpt-5.4-mini",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push *": "deny"
    },
    "edit": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 30000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 10
  },
  "provider": {
    "openrouter": {
      "models": {
        "~anthropic/claude-sonnet-latest": {},
        "~openai/gpt-latest": {},
        "~google/gemini-pro-latest": {},
        "~google/gemini-flash-latest": {},
        "anthropic/claude-opus-4.8": {},
        "openai/gpt-5.5": {},
        "google/gemini-3.1-pro-preview": {}
      }
    },
    "ollama": {
      "models": {
        "qwen3:8b": {
          "_launch": true,
          "name": "qwen3:8b"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
